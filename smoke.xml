<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Smoke Suite">
    <listeners>
        <listener class-name="com.pradeep.qa.listeners.TestListener"/>
    </listeners>
    <test name="Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.pradeep.qa.tests.LoginTest"/>
            <class name="com.pradeep.qa.tests.CartTest"/>
            <class name="com.pradeep.qa.tests.CheckoutTest"/>
        </classes>
    </test>
</suite>
